{"nodes": [{"id": "pytcad_m19_selfheating_plan", "label": "M19-SELFHEATING-PLAN.md", "file_type": "document", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_m19_self_heating", "label": "M19 Self-Heating Milestone", "file_type": "concept", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chose isothermal DD + outer Gummel thermal loop instead of a monolithic (psi,n,p,T) Newton system because Device1D's entire scaling framework is built from one scalar T at __init__; full monolithic coupling would be a disproportionate rewrite for the gates required."}, {"id": "concept_wachutka_joule_term", "label": "Wachutka 1990 quasi-Fermi-potential Joule dissipation term", "file_type": "rationale", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naive J*E Joule heating gives thermodynamically impossible negative heat in a diode's diffusion-dominated depletion region; the correct dissipation term uses gradients of the quasi-Fermi potentials phi_n=psi-ln(n/nie), phi_p=psi+ln(p/nie), verified to match I*V energy conservation to 0.04%."}, {"id": "pytcad_pytcad_thermal_py", "label": "pytcad/thermal.py", "file_type": "code", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pytcad_pytcad_device_py", "label": "pytcad/device.py (Device1D)", "file_type": "code", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pytcad_pytcad_materials_py", "label": "pytcad/materials.py", "file_type": "code", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pytcad_tests_test_m19_thermal", "label": "tests/test_m19_thermal.py", "file_type": "code", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_m19_thermal_runaway", "label": "Electro-thermal runaway (M19)", "file_type": "concept", "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "solve_electrothermal raises RuntimeError rather than returning a nonsense answer when the outer Gummel loop or inner thermal solve fails to converge, treating this as genuine physical thermal runaway rather than a numerics bug."}], "edges": [{"source": "pytcad_m19_selfheating_plan", "target": "concept_m19_self_heating", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "concept_m19_self_heating", "target": "pytcad_pytcad_thermal_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "pytcad_pytcad_thermal_py", "target": "pytcad_pytcad_device_py", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "pytcad_pytcad_thermal_py", "target": "pytcad_pytcad_materials_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pytcad/M19-SELFHEATING-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "pytcad_pytcad_thermal_py", "target": "concept_wachutka_joule_term", "relation": "implements", "confidence": "EX