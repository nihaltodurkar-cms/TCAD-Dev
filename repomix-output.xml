    psi = dev.psi + 0.02 * rng.standard_normal(dev.N)
    n = dev.n * (1.0 + 0.01 * rng.standard_normal(dev.N))
    p = dev.p * (1.0 + 0.01 * rng.standard_normal(dev.N))
