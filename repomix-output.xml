def test_extrinsic_enhancement_matches_fair_model_at_published_ratios():
    """M24 gate G2: Fair's pair-diffusion enhancement factor D/Di =
    f_I(n/ni) + f_V(ni/n) must equal 1 exactly at n=ni (intrinsic), and
