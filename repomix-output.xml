    mos = MOSCapacitor(Nsub=-1e17, tox_cm=5e-7, gate="n+poly")
    landmarks = mos.analytic_landmarks()
    assert c.max() == pytest.approx(landmarks["C_ox"], rel=0.10)
    assert c.max() > 4 * c.min()
