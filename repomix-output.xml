    # Create and destroy controllers
    for _ in range(10):
        ctl = AppController()
        del ctl
    
    # Force garbage collection
    gc.collect()
    
    # Get current and peak memory usage
    current, peak = tracemalloc.get_traced_memory()
    
    # Stop tracing
    tracemalloc.stop()
    
    # Check that memory usage is reasonable
