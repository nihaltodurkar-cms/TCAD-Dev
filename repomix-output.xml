def test_malformed_structure_regions_entry_is_rejected():
    d = examples.mosfet_3d_example_spec().to_dict()
    d["structure_regions"] = [{"box": [0, 1, 0, 1, 0, 1]}]   # missing "name"
    with pytest.raises(ValueError, match="structure_regions"):
