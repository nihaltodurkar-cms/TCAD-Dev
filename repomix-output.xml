    # move_region/move_step), so implant (ids[1]) is now at index 0 and
    # substrate (ids[0]) at index 1.
    assert [s.id for s in app.process_flow.steps] == [ids[1], ids[0]]
    app.duplicateProcessStep(ids[0])
