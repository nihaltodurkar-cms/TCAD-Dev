# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Generated example/run output (not source) -- examples/*.py write these
# next to themselves when run; solved-device results are equally runtime
# output, never checked in
*.png
*.npz

# Superpowers brainstorming visual-companion scratch (mockups, session state)
.superpowers/


# C++ engine build output (M31). The extension is written straight into
# pytcad/ by the in-place dev build so the repo's existing sys.path
# convention finds it; it is a build artifact, never checked in.
pytcad/_core*.so
pytcad/_core*.pyd
build/
