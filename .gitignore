# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Generated example/run output (not source) -- examples/*.py write these
# next to themselves when run; solved-device results are equally runtime
# output, never checked in
#
# tests/goldens/**/*.npz is DELIBERATELY covered by this rule, not an
# oversight. A golden pins one machine's numpy/scipy/BLAS summation
# order, not portable solver behaviour (AGENTS.md's "Hard rules" says
# why, and records the 2026-09-04 merge that proved it: byte-identical
# code in a different sandbox produced different golden bytes). Checking
# them in would make a machine-specific artifact look like a shared
# reference and would break every checkout that regenerated one. The
# pre-edit baseline is protected by the reconstruct-and-compare protocol
# in AGENTS.md instead.
*.png
*.npz

# Exception: a real shipped GUI asset, not a generated result plot --
# without this the app's QML Image source fails to load on any other
# checkout (see gui/qml/Main.qml's wallpaper Image, v3.0 glassmorphism).
!pytcad/gui/qml/assets/glass_wallpaper.png

# Superpowers brainstorming visual-companion scratch (mockups, session state)
.superpowers/


# C++ engine build output (M31). The extension is written straight into
# pytcad/ by the in-place dev build so the repo's existing sys.path
# convention finds it; it is a build artifact, never checked in.
pytcad/_core*.so
pytcad/_core*.pyd
build/
